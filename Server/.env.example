# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/cims_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin_user:RandomSecretPass123@cluster0.cims.mongodb.net/cims_database?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=cims_super_secret_jwt_key_987654321_phase1
JWT_EXPIRATION_TIME=7d

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@yourdomain.com
SMTP_PASS=app_password_random_abcd1234efgh
SMTP_FROM_NAME="CIMS Notifications"
SMTP_FROM_EMAIL=notifications@yourdomain.com

